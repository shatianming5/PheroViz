{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2_owner_remediation_execution_policy_v1.schema.json",
  "title": "C2 owner remediation execution policy",
  "description": "A pre-remediation policy for owner-authorized, non-independent execution. It contains no source classification, admission, publication, or scientific outcome authority.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_type",
    "policy_phase",
    "policy_id_sha256",
    "authorization_id_sha256",
    "trust_mode",
    "independent_verification",
    "admission_authorized",
    "publication_authorized",
    "frozen_universe",
    "chunk_actions",
    "allowed_operations",
    "source_extension_runtime_registry_required"
  ],
  "properties": {
    "schema_version": {
      "const": "c2-owner-remediation-execution-policy-v1"
    },
    "policy_type": {
      "const": "C2_OWNER_REMEDIATION_EXECUTION_POLICY"
    },
    "policy_phase": {
      "const": "PRE_REMEDIATION_EXECUTION"
    },
    "policy_id_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorization_id_sha256": {
      "const": "9dd1b4bdb93082d04e14ea8fd21a21ca40700614cc16975f2fee21541fb7e17a"
    },
    "trust_mode": {
      "const": "OWNER_AUTHORIZED_NON_INDEPENDENT"
    },
    "independent_verification": {
      "const": false
    },
    "admission_authorized": {
      "const": false
    },
    "publication_authorized": {
      "const": false
    },
    "frozen_universe": {
      "type": "object",
      "required": [
        "universe_file_sha256",
        "input_total",
        "partition"
      ],
      "properties": {
        "universe_file_sha256": {
          "const": "51848466c6bf6bf400b58faf539953830349abab21438e527eaefd74103450df"
        },
        "input_total": {
          "const": 2463
        },
        "partition": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/chunkBinding"
          }
        }
      },
      "additionalProperties": false
    },
    "chunk_actions": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/chunkAction"
      }
    },
    "allowed_operations": {
      "type": "array",
      "prefixItems": [
        {
          "const": "M3_READ_ONLY_PREFLIGHT"
        },
        {
          "const": "C2_REMEDIATION_EXECUTION"
        },
        {
          "const": "C2_SOURCE_EXTENSION_BUILD_REPLAY"
        },
        {
          "const": "C2_CANDIDATE_VALIDATION"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "source_extension_runtime_registry_required": {
      "const": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chunkId": {
      "enum": [
        "001",
        "002",
        "003",
        "004",
        "005",
        "006",
        "007",
        "008",
        "009",
        "010",
        "011",
        "012",
        "013"
      ]
    },
    "chunkBinding": {
      "type": "object",
      "required": [
        "chunk_id",
        "first_global_ordinal",
        "last_global_ordinal",
        "input_total",
        "chunk_file_sha256"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "first_global_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2463
        },
        "last_global_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2463
        },
        "input_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "chunk_file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "chunkAction": {
      "type": "object",
      "required": [
        "chunk_id",
        "required_action"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "required_action": {
          "enum": [
            "FRESH_REMEDIATION_REQUIRED",
            "CANDIDATE_V2_VALIDATION_ONLY",
            "STRICT_PATH_ONLY_DERIVATIVE_OR_REMEDIATION_REQUIRED",
            "TRANSPARENT_63_INPUT_DERIVATIVE_OR_FRESH_3X63_REQUIRED"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
