{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2_full_replacement_raw_record_v2.schema.json",
  "title": "C2 V2 raw attempt stream record",
  "type": "object",
  "required": [
    "attempt_id",
    "global_ordinal",
    "local_ordinal",
    "doi_id",
    "raw_disposition"
  ],
  "properties": {
    "attempt_id": {
      "enum": [
        "initial",
        "retry1",
        "retry2"
      ]
    },
    "global_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "local_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "doi_id": {
      "type": "string",
      "pattern": "^10\\.[0-9]{4,9}/\\S+$"
    },
    "raw_disposition": {
      "enum": [
        "PROCESSED",
        "SKIPPED"
      ]
    }
  },
  "additionalProperties": false
}
