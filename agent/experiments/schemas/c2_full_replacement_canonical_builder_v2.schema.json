{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2_full_replacement_canonical_builder_v2.schema.json",
  "title": "C2 V2.1 complete canonical builder output",
  "type": "object",
  "required": [
    "artifact_type",
    "parent_doi_id",
    "complete",
    "model_result_selected",
    "code",
    "builder_rule",
    "source_inventory_sha256",
    "raw_source_evidence_sha256",
    "candidate_manifest",
    "proposal_manifest",
    "review_manifest",
    "canonical_manifest",
    "parent_doi_ids_sha256",
    "source_cases",
    "cases"
  ],
  "properties": {
    "artifact_type": {
      "const": "c2_v21_canonical_builder_output"
    },
    "parent_doi_id": {
      "type": "string",
      "pattern": "^10\\.[0-9]{4,9}/\\S+$"
    },
    "raw_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "complete": {
      "const": true
    },
    "model_result_selected": {
      "const": false
    },
    "code": {
      "$ref": "#/$defs/cleanCodeWithHash"
    },
    "builder_rule": {
      "$ref": "#/$defs/rule"
    },
    "source_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "raw_source_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "proposal_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "review_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "canonical_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "parent_doi_ids_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceCase"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cleanCodeWithHash": {
      "type": "object",
      "required": [
        "commit",
        "sha256",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dirty": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "sourceCase": {
      "type": "object",
      "required": [
        "source_candidate_id",
        "parent_doi_id",
        "raw_source_sha256",
        "verified",
        "eligible_single_source"
      ],
      "properties": {
        "source_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_doi_id": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "raw_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified": {
          "const": true
        },
        "eligible_single_source": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": [
        "raw_source_evidence_sha256",
        "candidate_binding_sha256",
        "proposal_binding_sha256",
        "review_binding_sha256",
        "canonical_case_binding_sha256"
      ],
      "properties": {
        "raw_source_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proposal_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_case_binding_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "required": [
        "panel_id",
        "source_candidate_id",
        "parent_doi_id",
        "source_table_path",
        "source_table_sha256",
        "sheet_or_null",
        "raw_source_sha256",
        "candidate_binding_sha256",
        "proposal_binding_sha256",
        "canonical_case_binding_sha256",
        "verification_evidence_sha256"
      ],
      "properties": {
        "panel_id": {
          "type": "string",
          "minLength": 1
        },
        "source_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_doi_id": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "source_table_path": {
          "type": "string",
          "minLength": 1
        },
        "source_table_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sheet_or_null": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proposal_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_case_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verification_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "doi_id",
        "case_kind",
        "curation_status",
        "eligible_for_experiment",
        "asserted_panel_ids",
        "expected_evaluation_panel_ids",
        "asserted_panel_count",
        "asserted_public_stratum",
        "asserted_code_label",
        "verified_panels",
        "bindings"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "doi_id": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "case_kind": {
          "enum": [
            "single",
            "multi"
          ]
        },
        "curation_status": {
          "enum": [
            "verified",
            "rejected"
          ]
        },
        "eligible_for_experiment": {
          "type": "boolean"
        },
        "asserted_panel_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_evaluation_panel_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asserted_panel_count": {
          "type": "integer",
          "minimum": 0
        },
        "asserted_public_stratum": {
          "enum": [
            "P1",
            "P2",
            "P3_4",
            "P5PLUS"
          ]
        },
        "asserted_code_label": {
          "enum": [
            "P=1",
            "P=2",
            "P=3-4",
            "P=5+"
          ]
        },
        "verified_panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        }
      },
      "additionalProperties": false
    }
  }
}
