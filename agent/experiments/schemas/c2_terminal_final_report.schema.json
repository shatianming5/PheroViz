{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2_terminal_final_report.schema.json",
  "title": "C2 terminal-admission final universe report",
  "description": "A hash-bound terminal admission result. It intentionally has no trend, equivalence, or metric analysis fields.",
  "type": "object",
  "required": [
    "schema_version",
    "finalizer",
    "status",
    "claim_status",
    "claim_scope",
    "trend_status",
    "equivalence_status",
    "admission_manifest",
    "frozen_universe",
    "code",
    "chunks",
    "source_doi_ids_sha256",
    "source_doi_count",
    "strata",
    "deficient_strata",
    "final_report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finalizer": {
      "const": "c2_terminal_admission"
    },
    "status": {
      "enum": [
        "ADMITTED",
        "BLOCKED_INSUFFICIENT_INDEPENDENT_P1",
        "BLOCKED_INSUFFICIENT_INDEPENDENT_P2",
        "BLOCKED_INSUFFICIENT_INDEPENDENT_P3_4",
        "BLOCKED_INSUFFICIENT_INDEPENDENT_P5PLUS"
      ]
    },
    "claim_status": {
      "enum": [
        "SUPPORTED",
        "UNSUPPORTED"
      ]
    },
    "claim_scope": {
      "const": "TERMINAL_ADMISSION_ONLY"
    },
    "trend_status": {
      "const": "NOT_RUN"
    },
    "equivalence_status": {
      "const": "NOT_RUN"
    },
    "admission_manifest": {
      "type": "object",
      "required": [
        "file_sha256",
        "manifest_hash"
      ],
      "properties": {
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "frozen_universe": {
      "$ref": "#/$defs/frozenUniverse"
    },
    "code": {
      "$ref": "#/$defs/cleanCode"
    },
    "chunks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "source_doi_ids_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_doi_count": {
      "type": "integer",
      "minimum": 13
    },
    "strata": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/stratumCount"
      }
    },
    "deficient_strata": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "P=1",
          "P=2",
          "P=3-4",
          "P=5+"
        ]
      }
    },
    "final_report_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "chunkId": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "rootId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "cleanCode": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "dirty": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "frozenUniverse": {
      "type": "object",
      "required": [
        "sha256",
        "input_total",
        "doi_ids_sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_total": {
          "type": "integer",
          "minimum": 13
        },
        "doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": [
        "chunk_id",
        "root_id",
        "root_kind",
        "supersedes_root_id",
        "report_path",
        "report_file_sha256",
        "report_hash",
        "input_total",
        "input_doi_ids_sha256"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "root_id": {
          "$ref": "#/$defs/rootId"
        },
        "root_kind": {
          "enum": [
            "canonical",
            "replacement"
          ]
        },
        "supersedes_root_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_path": {
          "type": "string",
          "minLength": 6
        },
        "report_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "report_hash": {
          "$ref": "#/$defs/sha256"
        },
        "input_total": {
          "type": "integer",
          "minimum": 1
        },
        "input_doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "stratumCount": {
      "type": "object",
      "required": [
        "stratum",
        "source_doi_count",
        "independent_doi_cluster_count"
      ],
      "properties": {
        "stratum": {
          "enum": [
            "P=1",
            "P=2",
            "P=3-4",
            "P=5+"
          ]
        },
        "source_doi_count": {
          "type": "integer",
          "minimum": 0
        },
        "independent_doi_cluster_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
