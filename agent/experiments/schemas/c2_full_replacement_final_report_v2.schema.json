{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2_full_replacement_final_report_v2.schema.json",
  "title": "C2 V2.1 source-classification final report",
  "description": "A Stage-A synthetic report whose P strata derive only from verified source/canonical cases.",
  "type": "object",
  "required": [
    "schema_version",
    "finalizer",
    "status",
    "claim_status",
    "claim_scope",
    "decision",
    "trend_status",
    "equivalence_status",
    "policy_binding",
    "admission_manifest",
    "frozen_universe",
    "frozen_bindings",
    "code",
    "chunks",
    "canonical_attempt_ledger",
    "acquisition_dispositions",
    "acquisition_dispositions_sha256",
    "acquisition_disposition_doi_ids_sha256",
    "stratified_source_classifications",
    "stratified_source_doi_ids_sha256",
    "stratified_source_classifications_sha256",
    "non_stratified_doi_ids_sha256",
    "canonical_case_set_manifest_sha256",
    "per_doi_case_set_hashes_sha256",
    "terminal_status_counts",
    "disposition_counts",
    "strata",
    "deficient_strata",
    "final_report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1-stagea"
    },
    "finalizer": {
      "const": "c2_full_replacement_source_classification"
    },
    "status": {
      "enum": [
        "ADMITTED",
        "BLOCKED_INSUFFICIENT_INDEPENDENT_P2",
        "BLOCKED_INSUFFICIENT_INDEPENDENT_P3_4",
        "BLOCKED_INSUFFICIENT_INDEPENDENT_P5PLUS"
      ]
    },
    "claim_status": {
      "enum": [
        "SUPPORTED",
        "UNSUPPORTED"
      ]
    },
    "claim_scope": {
      "const": "STRATIFIED_SOURCE_TERMINAL_ADMISSION_ONLY"
    },
    "decision": {
      "enum": [
        "NOT_RUN_COVERAGE_GATE",
        "NOT_RUN_NO_ANALYSIS_AUTHORIZED"
      ]
    },
    "trend_status": {
      "const": "NOT_RUN"
    },
    "equivalence_status": {
      "const": "NOT_RUN"
    },
    "policy_binding": {
      "$ref": "#/$defs/policyBinding"
    },
    "admission_manifest": {
      "$ref": "#/$defs/manifestBinding"
    },
    "frozen_universe": {
      "$ref": "#/$defs/frozenUniverse"
    },
    "frozen_bindings": {
      "type": "object"
    },
    "code": {
      "$ref": "#/$defs/cleanCode"
    },
    "chunks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "canonical_attempt_ledger": {
      "type": "array",
      "minItems": 39,
      "maxItems": 39,
      "items": {
        "$ref": "#/$defs/attemptLedger"
      }
    },
    "acquisition_dispositions": {
      "type": "array",
      "minItems": 2463,
      "maxItems": 2463,
      "items": {
        "$ref": "#/$defs/acquisitionDisposition"
      }
    },
    "acquisition_dispositions_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "acquisition_disposition_doi_ids_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stratified_source_classifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceClassification"
      }
    },
    "stratified_source_doi_ids_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stratified_source_classifications_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "non_stratified_doi_ids_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_case_set_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "per_doi_case_set_hashes_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "terminal_status_counts": {
      "$ref": "#/$defs/counts"
    },
    "disposition_counts": {
      "$ref": "#/$defs/counts"
    },
    "strata": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/stratum"
      }
    },
    "deficient_strata": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "P2",
          "P3_4",
          "P5PLUS"
        ]
      }
    },
    "final_report_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.[0-9]{4,9}/\\S+$"
    },
    "chunkId": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "frozenUniverse": {
      "type": "object",
      "required": [
        "sha256",
        "doi_ids_sha256",
        "input_total"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_total": {
          "const": 2463
        }
      },
      "additionalProperties": false
    },
    "cleanCode": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "policyBinding": {
      "type": "object",
      "required": [
        "authority",
        "policy_id",
        "policy_version",
        "test_policy_sha256"
      ],
      "properties": {
        "authority": {
          "const": "SYNTHETIC_TEST_ONLY"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "test_policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "manifestBinding": {
      "type": "object",
      "required": [
        "file_sha256",
        "manifest_hash"
      ],
      "properties": {
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": [
        "chunk_id",
        "replacement_root_id",
        "retired_root_ids",
        "input_total",
        "input_doi_ids_sha256",
        "terminal_outcomes",
        "sealed_terminal_report",
        "sealed_report_hash"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "replacement_root_id": {
          "type": "string",
          "minLength": 1
        },
        "retired_root_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_total": {
          "type": "integer",
          "minimum": 1
        },
        "input_doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_outcomes": {
          "$ref": "#/$defs/artifact"
        },
        "sealed_terminal_report": {
          "$ref": "#/$defs/artifact"
        },
        "sealed_report_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "attemptLedger": {
      "type": "object",
      "required": [
        "chunk_id",
        "attempt_id",
        "raw_stream",
        "processed_success",
        "skipped_status",
        "outcomes"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "attempt_id": {
          "enum": [
            "initial",
            "retry1",
            "retry2"
          ]
        },
        "raw_stream": {
          "$ref": "#/$defs/artifact"
        },
        "processed_success": {
          "$ref": "#/$defs/artifact"
        },
        "skipped_status": {
          "$ref": "#/$defs/artifact"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "global_ordinal",
        "local_ordinal",
        "doi_id",
        "terminal_status_raw",
        "terminal_status"
      ],
      "properties": {
        "global_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "local_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "doi_id": {
          "$ref": "#/$defs/doi"
        },
        "terminal_status_raw": {
          "type": "string",
          "minLength": 1
        },
        "terminal_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "terminalEvidence": {
      "type": "object",
      "required": [
        "chunk_id",
        "input_doi_ids_sha256",
        "terminal_outcome_file_sha256",
        "sealed_report_file_sha256",
        "sealed_report_hash",
        "attempt_count",
        "terminal"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "input_doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_outcome_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sealed_report_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sealed_report_hash": {
          "$ref": "#/$defs/sha256"
        },
        "attempt_count": {
          "const": 3
        },
        "terminal": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "bindingOrNull": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "acquisitionDisposition": {
      "type": "object",
      "required": [
        "doi_id",
        "terminal_status_raw",
        "terminal_status",
        "terminal_evidence_binding",
        "final_disposition",
        "source_inventory_binding_or_null",
        "canonical_builder_binding_or_null",
        "all_eligible_case_ids",
        "classification_reason"
      ],
      "properties": {
        "doi_id": {
          "$ref": "#/$defs/doi"
        },
        "terminal_status_raw": {
          "type": "string",
          "minLength": 1
        },
        "terminal_status": {
          "type": "string",
          "minLength": 1
        },
        "terminal_evidence_binding": {
          "$ref": "#/$defs/terminalEvidence"
        },
        "final_disposition": {
          "type": "string",
          "minLength": 1
        },
        "source_inventory_binding_or_null": {
          "$ref": "#/$defs/bindingOrNull"
        },
        "canonical_builder_binding_or_null": {
          "$ref": "#/$defs/bindingOrNull"
        },
        "all_eligible_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "classification_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sourceClassification": {
      "type": "object",
      "required": [
        "doi_id",
        "cluster_id",
        "canonical_case_set_hash",
        "canonical_case_ids",
        "verified_panel_descriptors_sha256",
        "qualified_panel_counts",
        "derived_public_stratum",
        "derived_code_label",
        "source_binding_hashes"
      ],
      "properties": {
        "doi_id": {
          "$ref": "#/$defs/doi"
        },
        "cluster_id": {
          "$ref": "#/$defs/doi"
        },
        "canonical_case_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verified_panel_descriptors_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "qualified_panel_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "derived_public_stratum": {
          "enum": [
            "P1",
            "P2",
            "P3_4",
            "P5PLUS"
          ]
        },
        "derived_code_label": {
          "enum": [
            "P=1",
            "P=2",
            "P=3-4",
            "P=5+"
          ]
        },
        "source_binding_hashes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "stratum": {
      "type": "object",
      "required": [
        "p_disposition",
        "source_doi_count",
        "independent_cluster_count",
        "coverage_required",
        "coverage_met",
        "inference_eligible",
        "deficient"
      ],
      "properties": {
        "p_disposition": {
          "enum": [
            "P1",
            "P2",
            "P3_4",
            "P5PLUS"
          ]
        },
        "source_doi_count": {
          "type": "integer",
          "minimum": 0
        },
        "independent_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_required": {
          "type": "boolean"
        },
        "coverage_met": {
          "type": "boolean"
        },
        "inference_eligible": {
          "const": false
        },
        "deficient": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
