{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2_full_replacement_admission_manifest_v2.schema.json",
  "title": "C2 full-replacement V2 admission manifest",
  "description": "Stage-A manifest with only manifest-relative, sealed raw-evidence paths and no policy selector.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "manifest_hash",
    "frozen_universe",
    "code",
    "chunks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0-stagea"
    },
    "manifest_type": {
      "const": "c2_full_replacement_admission"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "frozen_universe": {
      "$ref": "#/$defs/frozenUniverse"
    },
    "code": {
      "$ref": "#/$defs/cleanCode"
    },
    "chunks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "chunkId": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\).+$"
    },
    "frozenUniverse": {
      "type": "object",
      "required": [
        "sha256",
        "doi_ids_sha256",
        "input_total"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_total": {
          "const": 2463
        }
      },
      "additionalProperties": false
    },
    "cleanCode": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "dirty": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "rootBinding": {
      "type": "object",
      "required": [
        "replacement_root_id",
        "retired_root_ids",
        "partial_root"
      ],
      "properties": {
        "replacement_root_id": {
          "$ref": "#/$defs/identifier"
        },
        "retired_root_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "partial_root": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "raw_stream",
        "processed_success",
        "skipped_status"
      ],
      "properties": {
        "attempt_id": {
          "enum": [
            "initial",
            "retry1",
            "retry2"
          ]
        },
        "raw_stream": {
          "$ref": "#/$defs/artifact"
        },
        "processed_success": {
          "$ref": "#/$defs/artifact"
        },
        "skipped_status": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": [
        "chunk_id",
        "root",
        "input_total",
        "input_doi_ids_sha256",
        "canonical_mapping",
        "attempts"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "root": {
          "$ref": "#/$defs/rootBinding"
        },
        "input_total": {
          "type": "integer",
          "minimum": 1
        },
        "input_doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_mapping": {
          "$ref": "#/$defs/artifact"
        },
        "attempts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
