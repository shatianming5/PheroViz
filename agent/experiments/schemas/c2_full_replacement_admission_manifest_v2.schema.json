{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2_full_replacement_admission_manifest_v2.schema.json",
  "title": "C2 V2.1 source-classification admission manifest",
  "description": "An exhaustive acquisition disposition attestation with source/canonical evidence, never a frozen DOI-to-P map.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "manifest_hash",
    "frozen_universe",
    "frozen_bindings",
    "code",
    "chunks",
    "source_canonical",
    "acquisition_dispositions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1-stagea"
    },
    "manifest_type": {
      "const": "c2_full_replacement_source_classification"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "frozen_universe": {
      "$ref": "#/$defs/frozenUniverse"
    },
    "frozen_bindings": {
      "$ref": "#/$defs/frozenBindings"
    },
    "code": {
      "$ref": "#/$defs/cleanCode"
    },
    "chunks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "source_canonical": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceCanonical"
      }
    },
    "acquisition_dispositions": {
      "type": "array",
      "minItems": 2463,
      "maxItems": 2463,
      "items": {
        "$ref": "#/$defs/acquisitionDisposition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.[0-9]{4,9}/\\S+$"
    },
    "chunkId": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "frozenUniverse": {
      "type": "object",
      "required": [
        "sha256",
        "doi_ids_sha256",
        "input_total"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_total": {
          "const": 2463
        }
      },
      "additionalProperties": false
    },
    "frozenBindings": {
      "type": "object",
      "required": [
        "universe_file_sha256",
        "universe_ordered_doi_ids_sha256",
        "universe_input_total",
        "universe_chunk_count",
        "universe_chunk_file_sha256_by_id",
        "universe_chunk_concat_sha256",
        "normalizer_code_commit_full",
        "normalizer_code_sha256",
        "canonical_builder_code_commit_full",
        "canonical_builder_code_sha256",
        "canonical_builder_rule_version",
        "canonical_builder_rule_sha256",
        "panel_recomputation_rule_version",
        "panel_recomputation_rule_sha256",
        "doi_case_aggregation_rule_version",
        "doi_case_aggregation_rule_sha256",
        "v2_schema_file_sha256"
      ],
      "properties": {
        "universe_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "universe_ordered_doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "universe_input_total": {
          "const": 2463
        },
        "universe_chunk_count": {
          "const": 13
        },
        "universe_chunk_file_sha256_by_id": {
          "type": "object",
          "minProperties": 13,
          "maxProperties": 13,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "universe_chunk_concat_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalizer_code_commit_full": {
          "$ref": "#/$defs/commit"
        },
        "normalizer_code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_builder_code_commit_full": {
          "$ref": "#/$defs/commit"
        },
        "canonical_builder_code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_builder_rule_version": {
          "type": "string",
          "minLength": 1
        },
        "canonical_builder_rule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "panel_recomputation_rule_version": {
          "type": "string",
          "minLength": 1
        },
        "panel_recomputation_rule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "doi_case_aggregation_rule_version": {
          "const": "DOI_CASE_AGGREGATION_V1"
        },
        "doi_case_aggregation_rule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "v2_schema_file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "cleanCode": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "dirty": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "rootBinding": {
      "type": "object",
      "required": [
        "replacement_root_id",
        "retired_root_ids",
        "partial_root"
      ],
      "properties": {
        "replacement_root_id": {
          "$ref": "#/$defs/identifier"
        },
        "retired_root_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "partial_root": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "raw_stream",
        "processed_success",
        "skipped_status"
      ],
      "properties": {
        "attempt_id": {
          "enum": [
            "initial",
            "retry1",
            "retry2"
          ]
        },
        "raw_stream": {
          "$ref": "#/$defs/artifact"
        },
        "processed_success": {
          "$ref": "#/$defs/artifact"
        },
        "skipped_status": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": [
        "chunk_id",
        "root",
        "input_total",
        "input_doi_ids_sha256",
        "terminal_outcomes",
        "sealed_terminal_report",
        "attempts"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "root": {
          "$ref": "#/$defs/rootBinding"
        },
        "input_total": {
          "type": "integer",
          "minimum": 1
        },
        "input_doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_outcomes": {
          "$ref": "#/$defs/artifact"
        },
        "sealed_terminal_report": {
          "$ref": "#/$defs/artifact"
        },
        "attempts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      },
      "additionalProperties": false
    },
    "sourceCanonical": {
      "type": "object",
      "required": [
        "doi_id",
        "source_inventory",
        "canonical_builder"
      ],
      "properties": {
        "doi_id": {
          "$ref": "#/$defs/doi"
        },
        "source_inventory": {
          "$ref": "#/$defs/artifact"
        },
        "canonical_builder": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "terminalEvidence": {
      "type": "object",
      "required": [
        "chunk_id",
        "input_doi_ids_sha256",
        "terminal_outcome_file_sha256",
        "sealed_report_file_sha256",
        "sealed_report_hash",
        "attempt_count",
        "terminal"
      ],
      "properties": {
        "chunk_id": {
          "$ref": "#/$defs/chunkId"
        },
        "input_doi_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_outcome_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sealed_report_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sealed_report_hash": {
          "$ref": "#/$defs/sha256"
        },
        "attempt_count": {
          "const": 3
        },
        "terminal": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "acquisitionDisposition": {
      "type": "object",
      "required": [
        "doi_id",
        "terminal_status_raw",
        "terminal_status",
        "terminal_evidence_binding",
        "final_disposition",
        "source_inventory_binding_or_null",
        "canonical_builder_binding_or_null",
        "all_eligible_case_ids",
        "classification_reason"
      ],
      "properties": {
        "doi_id": {
          "$ref": "#/$defs/doi"
        },
        "terminal_status_raw": {
          "enum": [
            "downloaded",
            "no-source-data",
            "no-figures",
            "no-usable-content",
            "policy-rejected",
            "fetch-error",
            "download-failed",
            "retry-exhausted"
          ]
        },
        "terminal_status": {
          "enum": [
            "DOWNLOADED",
            "NO_SOURCE_DATA",
            "NO_FIGURES",
            "NO_USABLE_CONTENT",
            "POLICY_REJECTED",
            "DOWNLOAD_FAILED",
            "RETRY_EXHAUSTED"
          ]
        },
        "terminal_evidence_binding": {
          "$ref": "#/$defs/terminalEvidence"
        },
        "final_disposition": {
          "enum": [
            "NON_STRATIFIED_NO_SOURCE_DATA",
            "NON_STRATIFIED_NO_FIGURES",
            "NON_STRATIFIED_NO_USABLE_CONTENT",
            "NON_STRATIFIED_POLICY_REJECTED",
            "NON_STRATIFIED_DOWNLOAD_FAILED",
            "NON_STRATIFIED_RETRY_EXHAUSTED",
            "NON_STRATIFIED_DOWNLOADED_NO_VERIFIED_SOURCE",
            "NON_STRATIFIED_SOURCE_NO_CANONICAL_CASE",
            "STRATIFIED_SOURCE_CANONICAL"
          ]
        },
        "source_inventory_binding_or_null": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "canonical_builder_binding_or_null": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "all_eligible_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "classification_reason": {
          "enum": [
            "TERMINAL_NO_SOURCE_DATA",
            "TERMINAL_NO_FIGURES",
            "TERMINAL_NO_USABLE_CONTENT",
            "TERMINAL_POLICY_REJECTED",
            "TERMINAL_DOWNLOAD_FAILED",
            "TERMINAL_RETRY_EXHAUSTED",
            "DOWNLOADED_EMPTY_VERIFIED_SOURCE_INVENTORY",
            "DOWNLOADED_NO_QUALIFYING_CANONICAL_CASE",
            "VERIFIED_SOURCE_CANONICAL_CASES"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
