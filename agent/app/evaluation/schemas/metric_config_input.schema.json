{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pheroviz.local/schemas/evaluation/metric-config-input-1.0.0.json",
  "title": "PheroViz partial metric configuration input",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "metric_version": {"type": "string", "minLength": 1},
    "numeric_tolerance": {"$ref": "#/$defs/partial_tolerance"},
    "limit_tolerance": {"$ref": "#/$defs/partial_tolerance"},
    "float_precision": {"type": "integer", "minimum": 0, "maximum": 15},
    "case_sensitive_labels": {"type": "boolean"},
    "allow_missing_shared_units": {"type": "boolean"},
    "unit_aliases": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "partial_tolerance": {
      "type": "object",
      "properties": {
        "absolute": {"type": "number", "minimum": 0},
        "relative": {"type": "number", "minimum": 0}
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}
